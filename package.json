{
  "name": "kofeely-lucky-wheel",
  "version": "1.0.0",
  "description": "Lucky Wheel spin-to-win app for Kofeely Coffee cart",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "qr": "node make_qr.js",
